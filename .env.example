# Invio email tramite Resend (https://resend.com) — senza queste variabili
# la risposta viene solo loggata in console e la pagina funziona comunque.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Dove ricevi la risposta
DATE_MAIL_TO=gianluca.bianchini.job@gmail.com

# Mittente verificato su Resend (per test va bene onboarding@resend.dev)
DATE_MAIL_FROM="Grogu Date <onboarding@resend.dev>"

# Nome mostrato nella pagina ("Trasmissione da ...")
SENDER_NAME=Gianlu

# URL pubblico, usato per l'immagine di preview su WhatsApp/social
NEXT_PUBLIC_SITE_URL=https://esempio.vercel.app
